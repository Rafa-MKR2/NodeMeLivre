{
  "name": "@nodemelivre/sdk",
  "version": "1.0.0-beta.1",
  "description": "NodeMeLivre: SDK TypeScript modular para a API do Mercado Livre",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nodemelivre/auth": "^1.0.0-beta.1",
    "@nodemelivre/core": "^1.0.0-beta.1",
    "@nodemelivre/errors": "^1.0.0-beta.1",
    "@nodemelivre/http": "^1.0.0-beta.1",
    "@nodemelivre/images": "^1.0.0-beta.1",
    "@nodemelivre/items": "^1.0.0-beta.1",
    "@nodemelivre/messages": "^1.0.0-beta.1",
    "@nodemelivre/orders": "^1.0.0-beta.1",
    "@nodemelivre/questions": "^1.0.0-beta.1",
    "@nodemelivre/shipments": "^1.0.0-beta.1",
    "@nodemelivre/types": "^1.0.0-beta.1",
    "@nodemelivre/users": "^1.0.0-beta.1",
    "@nodemelivre/webhooks": "^1.0.0-beta.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  }
}
