{
  "name": "@nodemelivre/sdk",
  "version": "1.0.0-beta.1",
  "description": "NodeMeLivre: SDK TypeScript modular para a API do Mercado Livre",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nodemelivre/auth": "*",
    "@nodemelivre/core": "*",
    "@nodemelivre/errors": "*",
    "@nodemelivre/http": "*",
    "@nodemelivre/images": "*",
    "@nodemelivre/items": "*",
    "@nodemelivre/messages": "*",
    "@nodemelivre/orders": "*",
    "@nodemelivre/questions": "*",
    "@nodemelivre/shipments": "*",
    "@nodemelivre/types": "*",
    "@nodemelivre/users": "*",
    "@nodemelivre/webhooks": "*"
  }
}
