{
  "name": "@nodemelivre/messages",
  "version": "1.0.0",
  "description": "Recursos de mensagens (chat pós-venda) do NodeMeLivre para a API do Mercado Livre",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nodemelivre/core": "^1.0.0",
    "@nodemelivre/errors": "^1.0.0",
    "@nodemelivre/types": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
